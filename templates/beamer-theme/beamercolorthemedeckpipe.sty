\ProvidesPackage{beamercolorthemedeckpipe}[2024/01/01 deckpipe colour theme]

% Palette
\definecolor{dpNavy}{HTML}{003A70}
\definecolor{dpMidBlue}{HTML}{0077B6}
\definecolor{dpTeal}{HTML}{00B4D8}
\definecolor{dpLightGrey}{HTML}{F5F5F5}
\definecolor{dpMidGrey}{HTML}{AAAAAA}

% Base colours
\setbeamercolor{normal text}{fg=black, bg=white}
\setbeamercolor{structure}{fg=dpNavy}

% Title page
\setbeamercolor{title}{fg=dpNavy, bg=white}
\setbeamercolor{subtitle}{fg=dpMidBlue, bg=white}
\setbeamercolor{author}{fg=black}
\setbeamercolor{date}{fg=dpMidGrey}
\setbeamercolor{institute}{fg=black}

% Frame title
\setbeamercolor{frametitle}{fg=dpNavy, bg=white}

% Footer
\setbeamercolor{footline}{fg=dpMidGrey, bg=white}

% Blocks
\setbeamercolor{block title}{fg=white, bg=dpNavy}
\setbeamercolor{block body}{fg=black, bg=dpLightGrey}
\setbeamercolor{block title alerted}{fg=white, bg=dpMidBlue}
\setbeamercolor{block body alerted}{fg=black, bg=dpLightGrey}
\setbeamercolor{block title example}{fg=white, bg=dpTeal}
\setbeamercolor{block body example}{fg=black, bg=dpLightGrey}

% Alerts and emphasis
\setbeamercolor{alerted text}{fg=dpTeal}

% Lists
\setbeamercolor{itemize item}{fg=dpMidBlue}
\setbeamercolor{itemize subitem}{fg=dpMidBlue}
\setbeamercolor{itemize subsubitem}{fg=dpMidGrey}
\setbeamercolor{enumerate item}{fg=dpNavy}
\setbeamercolor{enumerate subitem}{fg=dpMidBlue}

% Progress / separation rules
\setbeamercolor{title rule}{fg=dpNavy}
\setbeamercolor{frame rule}{fg=dpNavy}
